rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isFireAgency() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_fire_agency/$(request.auth.uid))
      );
    }

    function isPoliceAgency() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_police_agency/$(request.auth.uid))
      );
    }

    function isMedicalAgency() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_medical_agency/$(request.auth.uid))
      );
    }

    function isAnyAgency() {
      return isFireAgency() || isPoliceAgency() || isMedicalAgency();
    }

    // School roles: security=police, drrm=fire, clinic=medical
    // These are stored in roles_general_users but need agency write access
    function isSchoolAgency() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_general_users/$(request.auth.uid));
    }

    // ── User profiles ───────────────────────────────────────────────────────

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin() || isAnyAgency() || isSchoolAgency();
      allow delete: if isAdmin();
    }

    // ── Role collections ────────────────────────────────────────────────────

    match /roles_admin/{uid} {
      allow get: if isSignedIn();
      allow create: if isOwner(uid);
      allow update, delete: if isAdmin();
    }

    match /roles_general_users/{uid} {
      allow get: if isSignedIn();
      allow create: if isOwner(uid);
      allow update, delete: if isAdmin();
    }

    match /roles_fire_agency/{uid} {
      allow get: if isSignedIn();
      allow create: if isOwner(uid);
      allow update, delete: if isAdmin();
    }

    match /roles_police_agency/{uid} {
      allow get: if isSignedIn();
      allow create: if isOwner(uid);
      allow update, delete: if isAdmin();
    }

    match /roles_medical_agency/{uid} {
      allow get: if isSignedIn();
      allow create: if isOwner(uid);
      allow update, delete: if isAdmin();
    }

    // ── User alerts (subcollection) ─────────────────────────────────────────

    match /users/{userId}/alerts/{alertId} {
      allow get, list: if isOwner(userId) || isAdmin() || isAnyAgency() || isSchoolAgency();
      allow create: if isOwner(userId) || isAnyAgency() || isSchoolAgency();
      allow update: if isSignedIn();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── User notifications (subcollection) ──────────────────────────────────

    match /users/{userId}/notifications/{notifId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── Agency alert queues ─────────────────────────────────────────────────

    match /agency_alerts_fire/{alertId} {
      allow create: if isSignedIn();
      allow read, list: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || isFireAgency() || isSchoolAgency();
    }

    match /agency_alerts_police/{alertId} {
      allow create: if isSignedIn();
      allow read, list: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || isPoliceAgency() || isSchoolAgency();
    }

    match /agency_alerts_medical/{alertId} {
      allow create: if isSignedIn();
      allow read, list: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || isMedicalAgency() || isSchoolAgency();
    }

    // ── All alerts (admin + agency read, anyone can create) ─────────────────

    match /all_alerts/{alertId} {
      allow create: if isSignedIn();
      allow get, list: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || isAnyAgency() || isSchoolAgency();
    }

    // ── Feedback / questionnaire ────────────────────────────────────────────

    match /users/{userId}/questionnaire_responses/{responseId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow delete: if isAdmin();
    }

    match /all_questionnaire_responses/{responseId} {
      allow create: if isSignedIn();
      allow read, list: if isAdmin();
    }

    // ── Admin settings ──────────────────────────────────────────────────────

    match /admin_settings/{uid} {
      allow read, write: if isAdmin() && isOwner(uid);
    }

    // ── Security logs ────────────────────────────────────────────────────────

    match /security_logs/{logId} {
      allow create: if isSignedIn();
      allow read, list: if isAdmin();
    }

    // ── Agency settings ──────────────────────────────────────────────────────

    match /agency_settings/{uid} {
      allow read, write: if isSignedIn() && isOwner(uid);
    }

    // ── Alert media (photo + voice stored separately) ───────────────────────

    match /alert_media/{alertId} {
      allow create: if isSignedIn();
      allow read, get, list: if isAdmin() || isAnyAgency() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Logs ────────────────────────────────────────────────────────────────

    match /logs/{logId} {
      allow create: if isSignedIn();
      allow read, list: if isAdmin();
    }
  }
}
